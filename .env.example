# Agent Readiness Insights v2 — Buffer
# Copy to .env (never commit .env). GitHub Actions uses Secrets.

# Buffer GraphQL API token — https://publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=

# Organization ID — node scripts/list-buffer-channels.mjs
BUFFER_ORGANIZATION_ID=

# Primary channel for ARI Insights LinkedIn queue (usually LinkedIn)
BUFFER_CHANNEL_ID=

# Per-service channel IDs (engineer@coas.asia example)
BUFFER_CHANNEL_ID_LINKEDIN=
BUFFER_CHANNEL_ID_TWITTER=
BUFFER_CHANNEL_ID_FACEBOOK=

# Set to true to save posts as drafts instead of scheduling (local testing)
BUFFER_SAVE_TO_DRAFT=false

# IndexNow — https://www.indexnow.org/documentation
# Hosted key file at the repo root ({key}.txt) is what the site serves and
# what submissions use. build:all copies it into public_build/.
# INDEXNOW_KEY is optional and must match that file. A secret alone never
# created the public file, which is why https://readiness.coaretail.com/{key}.txt
# 404'd (and /indexnow.txt is not the IndexNow filename).
# GitHub Actions: optional Secret INDEXNOW_KEY (publish continues if unset or mismatched)
# Vercel: optional Environment Variable INDEXNOW_KEY (not required for the hosted file)
INDEXNOW_KEY=

# Private ABIS Impact Watch — Slack Incoming Webhook (server/CI only; never VITE_)
# GitHub Actions: Secret ABIS_SLACK_WEBHOOK_URL
ABIS_SLACK_WEBHOOK_URL=

# OpenAI Image API — Diagram Gate (scripts/generate-diagram-image.mjs)
# Never commit .env. Use --dry-run locally without these keys.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Vercel Cron — strict 10:00 JST Insights publish (api/cron/publish-insights.js)
# Set on Vercel Production only. Never commit real values.
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=CoaRetail/AI_readiness_index
+
# OISUMMIT internal capture (server-only; never commit real values)
# API accepts writes only when all four are configured.
OISUMMIT_CAPTURE_ACCESS_TOKEN=
OISUMMIT_CAPTURE_WRITE_ENABLED=false
OISUMMIT_CAPTURES_TABLE_NAME=OISUMMIT_Captures
# Optional dedicated token for Grok Bot sidecar (falls back to OISUMMIT_CAPTURE_ACCESS_TOKEN)
OISUMMIT_GROK_CAPTURE_BOT_TOKEN=

# ARI X Traffic Sidecar v1.0 — disabled by default; never enable without approval
ARI_X_TRAFFIC_ENABLED=false
ARI_X_TRAFFIC_DRY_RUN=true
ARI_X_TRAFFIC_LIVE_CREATE=false
ARI_X_TRAFFIC_COOLDOWN_DAYS=14
# Conservative X limit; Buffer documents 280 for X Free and 25,000 for higher tiers.
ARI_X_TRAFFIC_MAX_UTF16=279
